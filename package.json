{
  "name": "nexus-desk",
  "productName": "Nexus Desk",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI Workspace cho Windows",
  "main": "./out/main/index.js",
  "author": "namtr",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^3.6.1",
    "better-sqlite3": "^13.2.0",
    "docx": "^9.16.1",
    "drizzle-orm": "^0.45.4",
    "electron-log": "^5.4.4",
    "fast-xml-parser": "^5.12.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "^5.1.2"
  }
}
